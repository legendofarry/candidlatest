# Paste the current service-account JSON here as a single-line JSON value.
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_PROJECT_ID=your_firebase_project_id_here
# Set a long random key shared only with the owner console.
OWNER_API_KEY=your_owner_api_key_here
# Exact owner console origins, comma-separated if more than one.
OWNER_APP_ORIGIN=https://your-app-origin.example.com
# Server-side AI story/evidence moderation and support assistant. Never use VITE_.
OPENROUTER_API_KEY=
# Cloudinary unsigned client upload configuration (no API secret belongs here).
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=
# Server-only credentials for signed, authenticated evidence uploads. Never use VITE_ here.
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Developer-only access controls.
VITE_DEVELOPER_MODE=false
# Email allowed to claim the official account.
DEVELOPER_EMAIL=

# Firebase Console > Project settings > Cloud Messaging > Web Push certificates.
VITE_FIREBASE_VAPID_KEY=
# Public URL used as the destination when a push notification is tapped.
PUBLIC_APP_URL=https://your-app-url.example.com
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_firebase_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_firebase_project_id_here
VITE_FIREBASE_DATABASE_URL=https://your_firebase_project-default-rtdb.example.com
FIREBASE_DATABASE_URL=https://your_firebase_project-default-rtdb.example.com
VITE_TURN_SERVER_URL=
VITE_TURN_USERNAME=
VITE_TURN_CREDENTIAL=
VITE_FIREBASE_STORAGE_BUCKET=your_firebase_project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_firebase_sender_id_here
VITE_FIREBASE_APP_ID=your_firebase_app_id_here
