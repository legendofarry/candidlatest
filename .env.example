# Paste the current service-account JSON here as a single-line JSON value.
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_PROJECT_ID=candid-bbef5
# Set a long random key shared only with the owner console.
OWNER_API_KEY=replace-with-a-random-secret
# Exact owner console origins, comma-separated if more than one.
OWNER_APP_ORIGIN=http://localhost:4175
# Server-side AI story/evidence moderation and support assistant. Never use VITE_.
OPENROUTER_API_KEY=
# Cloudinary unsigned client upload configuration (no API secret belongs here).
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=
# Server-only credentials for signed, authenticated evidence uploads. Never use VITE_ here.
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Local developer tools. Never enable these in a production Netlify deploy.
VITE_DEVELOPER_MODE=false
ALLOW_DEVELOPMENT_DATABASE_RESET=false
DEVELOPER_EMAIL=

# Firebase Console > Project settings > Cloud Messaging > Web Push certificates.
VITE_FIREBASE_VAPID_KEY=
# Public URL used as the destination when a push notification is tapped.
PUBLIC_APP_URL=https://candid-beta.netlify.app
