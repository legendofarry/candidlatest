{
  "rules": {
    ".read": false,
    ".write": false,
    "presence": {
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.hasChildren(['state', 'last_changed']) && newData.child('state').isString() && (newData.child('state').val() === 'online' || newData.child('state').val() === 'offline') && newData.child('last_changed').isNumber()",
        "$other": {
          ".validate": false
        }
      }
    },
    "user_calls": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        "$callId": {
          ".write": "auth != null && auth.uid === $uid && !newData.exists() && (!root.child('call_rooms').child($callId).child('meta').child('members').child(auth.uid).exists() || root.child('call_rooms').child($callId).child('meta').child('status').val() === 'ended')"
        }
      }
    },
    "call_expirations": {
      ".read": false,
      ".write": false,
      ".indexOn": ["expires_at"]
    },
    "call_rooms": {
      "$callId": {
        "meta": {
          ".read": "auth != null && (data.child('creator_id').val() === auth.uid || data.child('members').child(auth.uid).exists())",
          ".write": false
        },
        "join_requests": {
          ".read": "auth != null && root.child('call_rooms').child($callId).child('meta').child('creator_id').val() === auth.uid",
          ".write": false
        },
        "signals": {
          "$fromUid": {
            "$toUid": {
              ".read": "auth != null && auth.uid === $toUid && root.child('call_rooms').child($callId).child('meta').child('status').val() !== 'ended' && root.child('call_rooms').child($callId).child('meta').child('members').child($fromUid).child('status').val() === 'active' && root.child('call_rooms').child($callId).child('meta').child('members').child($toUid).child('status').val() === 'active'",
              "$kind": {
                ".validate": "$kind === 'offer' || $kind === 'answer' || $kind === 'candidate'",
                "$signalId": {
                  ".write": "auth != null && auth.uid === $fromUid && !data.exists() && root.child('call_rooms').child($callId).child('meta').child('status').val() !== 'ended' && root.child('call_rooms').child($callId).child('meta').child('members').child($fromUid).child('status').val() === 'active' && root.child('call_rooms').child($callId).child('meta').child('members').child($toUid).child('status').val() === 'active'",
                  ".validate": "newData.hasChildren()"
                }
              }
            }
          }
        }
      }
    }
  }
}
